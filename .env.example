# Public Supabase credentials — safe to expose in the browser bundle.
# Set these in Vercel (build-time) and in .env.local for local dev.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed to run `npm run migrate:supabase` (the one-time JSON -> Supabase
# import). Bypasses RLS — keep it local, never commit it or add it to CI/Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Where `npm run db:seed` reads content from when building the local seed file.
# Point these at the hosted project (Supabase dashboard -> Project Settings ->
# API) even while VITE_SUPABASE_URL points at the local stack. Public values,
# same as the pair above.
SEED_SOURCE_SUPABASE_URL=
SEED_SOURCE_SUPABASE_ANON_KEY=
